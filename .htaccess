# Provigood — Apache configuration for the Gandi hosting.
# Copied into dist/ by tools/build-dist.sh; GitHub Pages ignores it.
# Every block sits in <IfModule>, so a missing module is skipped instead
# of breaking the site.

# ---------------------------------------------------------------------
# Browser caching
#
# styles.css and script.js carry a ?v= version in every page. A release
# changes that version, so browsers fetch the new file at once: a one-year
# (self-hosted fonts carry their version in the file name instead)
# cache is safe for them, marked immutable to skip revalidation too.
#
# Most images have no version in their URL, so they get 30 days only. An
# image replaced under the same file name could stay stale for returning
# visitors up to that long: give a changed image a new file name.
#
# HTML, the sitemap and robots.txt are revalidated on every visit, so
# page updates show immediately after an upload.
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 30 days"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Error page ----------
# Unknown URLs get the site's own 404 page, with its menu, instead of
# Apache's default one. build-dist.sh makes its stylesheet path
# root-absolute so it renders at any depth, /en/missing.html included.
ErrorDocument 404 /404.html

# ---------- Redirects ----------
# 1. The domain root goes straight to https://provigood.com/en/ in one hop,
#    whatever the scheme or www prefix. index.html keeps its script and meta
#    refresh as a fallback.
# 2. www.provigood.com -> https://provigood.com, same path.
# 3. Plain HTTP on provigood.com -> HTTPS. Gandi terminates TLS in front of
#    Apache and passes the original scheme in X-Forwarded-Proto, so the rule
#    checks that header as well as HTTPS. Rules 1-3 only apply to
#    provigood.com: a temporary Gandi test address without a certificate
#    keeps working, with the root sent to /en/ on its own host (rule 4).
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^(www\.)?provigood\.com$ [NC]
  RewriteRule ^$ https://provigood.com/en/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.provigood\.com$ [NC]
  RewriteRule ^ https://provigood.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^provigood\.com$ [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://provigood.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^$ /en/ [R=301,L]
</IfModule>

# ---------- Compression ----------
# Text files only: images and WOFF2 fonts are already compressed.
<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

# ---------- Security headers ----------
# Browsers ignore HSTS over plain HTTP: it takes effect once HTTPS is on.
# The CSP lists everything the site loads: its own files, the YouTube player
# (API script from www.youtube.com, frames from youtube-nocookie.com, both
# only after a click) and the root index.html inline script, by hash.
# Adding a third-party script, font or embed means adding its host here;
# editing that inline script means recomputing its hash.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com 'sha256-q4TJsWTvq13xtA78Zg4bCs5bdTsHp9Kr7SSlM0gJj8I='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
