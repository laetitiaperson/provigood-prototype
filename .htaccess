# Provigood — Apache configuration for the Gandi hosting.
# Copied into dist/ by tools/build-dist.sh; GitHub Pages ignores it.
# Every block sits in <IfModule>, so a missing module is skipped instead
# of breaking the site.

# ---------------------------------------------------------------------
# Browser caching
#
# styles.css and script.js carry a ?v= version in every page. A release
# changes that version, so browsers fetch the new file at once: a one-year
# cache is safe for them, marked immutable to skip revalidation too.
#
# Most images have no version in their URL, so they get 30 days only. An
# image replaced under the same file name could stay stale for returning
# visitors up to that long: give a changed image a new file name.
#
# HTML, the sitemap and robots.txt are revalidated on every visit, so
# page updates show immediately after an upload.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 30 days"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
